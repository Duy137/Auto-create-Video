# .env.example — Copy to .env and fill in values

# ── Required API Keys ──
OPENAI_API_KEY=sk-your-openai-key-here
PEXELS_API_KEY=your-pexels-api-key-here

# ── Optional API Keys ──
GOOGLE_API_KEY=your-google-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
QWEN_API_KEY=sk-your-dashscope-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Auth ──
JWT_SECRET_KEY=change-this-to-a-random-string

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_TTL_SECONDS=86400
JOB_STORE_BACKEND=auto

# ── Content Parser LLM ──
CONTENT_PARSER_PROVIDER=qwen
CONTENT_PARSER_MODEL=qwen3.5-flash

# ── Optional VLM Media Reranker ──
VLM_RERANK_ENABLED=true
VLM_RERANK_PROVIDER=qwen
VLM_RERANK_MODEL=qwen3-vl-reranker
VLM_RERANK_MAX_CANDIDATES=6
VLM_RERANK_TIMEOUT_SECONDS=20
VLM_RERANK_MAX_CONCURRENCY=3

# ── Semantic Query Builder (scene summary -> search phrase) ──
SEMANTIC_QUERY_ENABLED=true
SEMANTIC_QUERY_MAX_WORDS=4
SEMANTIC_LLM_QUERY_ENABLED=true

# ── AI Logging (do not change) ──
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log
