# .env.example — Copy to .env and fill in values

# ── API Keys ──
OPENAI_API_KEY=sk-your-openai-key-here
PEXELS_API_KEY=your-pexels-api-key-here

# ── Optional API Keys ──
GOOGLE_API_KEY=your-google-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
QWEN_API_KEY=sk-your-dashscope-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VBEE_APP_ID=your-vbee-app-id-here
VBEE_API_TOKEN=your-vbee-api-token-here

# ── Models ──
CONTENT_PARSER_OPENAI_MODEL=gpt-4o-mini
CONTENT_PARSER_PROVIDER=openai

# ── Redis (Optional for local, used if you have Memurai) ──
REDIS_URL=redis://localhost:6379/0

# ── Pipeline Settings ──
VLM_RERANK_ENABLED=false
VLM_RERANK_PROVIDER=qwen
VLM_RERANK_MODEL=qwen3-omni-flash